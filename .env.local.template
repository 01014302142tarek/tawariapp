# =============================================================================
# TawariApp — LOCAL ONLY (your Supabase project, not production)
# Copy to .env.local:  copy .env.local.template .env.local
# Or run: npm run setup:local
# Never commit .env.local (already in .gitignore)
# =============================================================================

# --- Required: YOUR new project at https://supabase.com/dashboard ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Aliases (optional; app reads NEXT_PUBLIC_* above first)
# NEXT_PUBLIC_TawariAppSUPABASE_URL=
# NEXT_PUBLIC_TawariAppSUPABASE_ANON_KEY=

# App URLs (keep localhost for private dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional integrations (leave empty to avoid touching prod services) ---
# DAILY_API_KEY=
# NEXT_PUBLIC_DAILY_DOMAIN=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Tawari Dev <dev@localhost>
# PAYMOB_*=

# Database direct URL (only for scripts: seed-comprehensive-demo.sql, etc.)
# POSTGRES_URL=
# POSTGRES_URL_NON_POOLING=
