# Copy .env.local.template to .env.local for private local dev (see docs/LOCAL_PRIVATE_DEV.md)

# Supabase (use YOUR project — not production)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Daily.co Video (optional locally)
# DAILY_API_KEY=
# NEXT_PUBLIC_DAILY_DOMAIN=

# Resend Email (optional locally)
# RESEND_API_KEY=

# Database (for scripts/migrations)
# POSTGRES_URL=postgresql://...
# POSTGRES_URL_NON_POOLING=postgresql://...
